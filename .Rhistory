boxplot(data$`Der gemeinsame Austausch in der Tee-Ecke nach dem Spiel hat geholfen, Unbehagen abzubauen.`[data$`Der gemeinsame Austausch in der Tee-Ecke nach dem Spiel hat geholfen, Unbehagen abzubauen.`!=-99 & data$`Der gemeinsame Austausch in der Tee-Ecke nach dem Spiel hat geholfen, Unbehagen abzubauen.`!=-98])
