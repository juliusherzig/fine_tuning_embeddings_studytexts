boxplot(data$Effekt_Einblicke) #Leute, die gar nicht zustimmen, neue Einblicke erhalten zu haben, sind in der Minderheit und Ausreißer. Für mich aber kein Grund für Ausschluss - ist immerhin eine plausible Antwort
boxplot(data$Effekt_DenkenHandeln)
boxplot(data$Effekt_FremdheitNachempfinden)
table(data$Effekt_FremdheitNachempfinden) #Hier das gleiche wie bei Einblicken.
# Ich mache hier ein Subset mit den Variablen, bei denen es Ausreißer in den Boxplots gab. Um zu gucken, ob die Ausreißer zufällig immer die gleichen Personen sind. Dann wäre das vielleicht ein Ausschlussgrund. Einzeln würde ich sagen, dass ein Ausreißersein in einer einzelnen Variable kein Grund für einen Ausschluss ist.
outlier_subset <- subset(data, select= c(`Der gemeinsame Austausch in der Tee-Ecke nach dem Spiel hat geholfen, Unbehagen abzubauen.`, `Der gemeinsame Austausch in der Tee-Ecke nach dem Spiel hat geholfen, das eigene Fremdheitserleben einzuordnen?`, Effekt_Einblicke, Effekt_FremdheitNachempfinden, Unbehagengefühlt, id))
# Funktion: Ausreißer nach IQR-Kriterium (alternativ z-Score)
is_outlier <- function(x) {
q1 <- quantile(x, 0.25, na.rm = TRUE)
q3 <- quantile(x, 0.75, na.rm = TRUE)
iqr <- q3 - q1
x < (q1 - 1.5 * iqr) | x > (q3 + 1.5 * iqr)
}
# Schritt 1: Für jede Variable Outlier-Flags berechnen
outlier_flags <- as.data.frame(lapply(outlier_subset[,1:5], is_outlier))
# Schritt 2: Zeilenweise aufsummieren – wie viele Variablen mit Ausreißern?
outlier_flags$outlier_count <- rowSums(outlier_flags)
# Schritt 3: Wer ist in mehreren Variablen ein Ausreißer?
table(outlier_flags$outlier_count)
# Optional: anzeigen, welche Personen mehrfach betroffen sind
multi_outlier <- outlier_subset[which(outlier_flags$outlier_count == 5),]
