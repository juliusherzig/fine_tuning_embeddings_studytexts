# 4-Teilung der Texte an Satzgrenzen
#Vorgehen: Berechnung der Satzlänge, dann Abschneiden bei : Damit es nicht mitten im Satz oder Wort geteilt wird,
#vorher mit tokenziers Sätze zählen und die durch vier teilen und
# dann hinter dem entsprechenden Satz splitten
#das sind alle Sätze, einzeln aufgelistet, für alle Texte
all_sentences <- tokenizers::tokenize_sentences(data$studytext)
#Anzahl an Sätzen pro Text
data$n_sentences <- NA
for (i in c(1:nrow(data))) {
data$n_sentences[i] <- length(unlist
(tokenizers::tokenize_sentences
(data$studytext[i])))
}
#Aufteilung in 4
data$studytext_part1 <- NA
data$studytext_part2 <- NA
data$studytext_part3 <- NA
data$studytext_part4 <- NA
for (i in c(1:nrow(data))) {
data$studytext_part1[i] <- paste(all_sentences[[i]][1:floor(1/4*(data$n_sentences[i]))],
collapse = "")
data$studytext_part2[i] <- paste(all_sentences[[i]][(floor(1/4*(data$n_sentences[i]))+1):(floor(1/2*(data$n_sentences[i])))],
collapse = "")
data$studytext_part3[i] <- paste(all_sentences[[i]][(floor(1/2*(data$n_sentences[i]))+1):(floor(3/4*(data$n_sentences[i])))],
collapse = "")
data$studytext_part4[i] <- paste(all_sentences[[i]][(floor(3/4*(data$n_sentences[i]))+1):(data$n_sentences[i])],
collapse = "")
}
