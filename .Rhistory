) %>%
mutate(`Alter Kategorien` = `Dein Alter`)
#
dank_spalte <- post_clean$`Dank des Besuches in der Republik Fremdistan...`
# Funktion zum Umwandeln der Spalte in eine Liste
parse_dank <- function(x) {
if (is.na(x)) return(NULL)  # Fehlende Werte ignorieren
x <- str_replace_all(x, "X", "NA")  # 'X' durch NA ersetzen
key_value_pairs <- str_split(x, ",\\s*")[[1]]
result <- setNames(as.numeric(str_extract(key_value_pairs, "\\d+$")),
str_trim(str_remove(key_value_pairs, " : \\d+$")))
return(result)
}
# Liste mit allen extrahierten Werten
parsed_list <- lapply(dank_spalte, parse_dank)
# Datenframe mit Gründen als Spalten
dank_df <- bind_rows(parsed_list)
#Vier Spalten entfernen
dank_df <- dank_df[1:3]
# Ursprünglichen Datensatz mit den extrahierten Spalten zusammenführen
post_clean <- bind_cols(post_clean, dank_df)
#zu numeric machen
post_clean$`...habe ich Einblicke in die Lebenssituation von Neuzugewanderten in Deutschland erhalten.` <- as.numeric(post_clean$`...habe ich Einblicke in die Lebenssituation von Neuzugewanderten in Deutschland erhalten.`)
post_clean$`...kann ich das Fremdheitsempfinden von Neuzugewanderten in Deutschland besser nachempfinden.` <- as.numeric(post_clean$`...kann ich das Fremdheitsempfinden von Neuzugewanderten in Deutschland besser nachempfinden.`)
post_clean$`...hat sich mein Denken oder Handeln verändert.` <- as.numeric(post_clean$`...hat sich mein Denken oder Handeln verändert.`)
#Und das Gleiche für die Spalte Untitled choice-matrix
names(post_clean)[names(post_clean) == "Untitled choice-matrix"] <- "Gründe für Unbehagen"
# Spalte mit Gründen extrahieren
unbehagen_spalte <- post_clean$`Gründe für Unbehagen`
# Funktion zum Umwandeln der Spalte in eine Liste
parse_unbehagen <- function(x) {
if (is.na(x)) return(NULL)  # Fehlende Werte ignorieren
x <- str_replace_all(x, "X", "NA")  # 'X' durch NA ersetzen
key_value_pairs <- str_split(x, ",\\s*")[[1]]
result <- setNames(as.numeric(str_extract(key_value_pairs, "\\d+$")),
str_trim(str_remove(key_value_pairs, " : \\d+$")))
return(result)
}
# Liste mit allen extrahierten Werten
parsed_list <- lapply(unbehagen_spalte, parse_unbehagen)
# Datenframe mit Gründen als Spalten
unbehagen_df <- bind_rows(parsed_list)
# Ursprünglichen Datensatz mit den extrahierten Spalten zusammenführen
post_clean <- bind_cols(post_clean, unbehagen_df)
#NA Spalten weg
na_spalten <- colSums(is.na(post_clean)) == nrow(post_clean)
post_clean <- post_clean[, !na_spalten]
#Umbenennen
names(post_clean)[names(post_clean)=="...)"] <- "Durchsuchen persönlicher Gegenstände (Betten, Rucksäcke, ...)"
names(post_clean)[names(post_clean)=="wo ich nicht hingehöre"] <- "Gefühl, an einem Ort zu sein, wo ich nicht hingehöre"
#Aufräumen:
rm(dank_df, parsed_list, unbehagen_df, dank_spalte, unbehagen_spalte, parse_dank, parse_unbehagen, na_spalten)
