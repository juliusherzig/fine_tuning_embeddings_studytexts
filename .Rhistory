library(jsonlite)
library(dplyr)
#Dataframe nur mit Label, Text (jeweiligem Abschnitt) und Studien-ID
text_part1 <- select(data, c(studytext_part1,Replication_Success_Sig_Dir, Number_Original))
text_part2 <- select(data, c(studytext_part2,Replication_Success_Sig_Dir, Number_Original))
text_part3 <- select(data, c(studytext_part3,Replication_Success_Sig_Dir, Number_Original))
text_part4 <- select(data, c(studytext_part4,Replication_Success_Sig_Dir, Number_Original))
#Umwandeln in jsonl-Format
text_part1 <- toJSON(text_part1, by_row=TRUE, auto_unbox = TRUE, pretty = FALSE)
text_part2 <- toJSON(text_part2, by_row=TRUE, auto_unbox = TRUE, pretty = FALSE)
text_part3 <- toJSON(text_part3, by_row=TRUE, auto_unbox = TRUE, pretty = FALSE)
text_part4 <- toJSON(text_part4, by_row=TRUE, auto_unbox = TRUE, pretty = FALSE)
# Eckige Klammern entfernen und Zeilenumbruch ("\n") hinter jeder Studie hinzufügen
#=> verwandelt JSON zu JSON ->LINE<- Format ("jsonl"; Charakteristikum: ein Objekt pro Zeile)
text_part1 <- gsub("\\]|\\[", "", text_part1)
text_part1 <- gsub("},", "}\n", text_part1)
text_part2 <- gsub("\\]|\\[", "", text_part2)
text_part2 <- gsub("},", "}\n", text_part2)
text_part3 <- gsub("\\]|\\[", "", text_part3)
text_part3 <- gsub("},", "}\n", text_part3)
text_part4 <- gsub("\\]|\\[", "", text_part4)
text_part4 <- gsub("},", "}\n", text_part4)
#Exportieren als .jsonl
writeLines(text_part1, "text_part1.jsonl")
writeLines(text_part3, "text_part3.jsonl")
writeLines(text_part4, "text_part4.jsonl")
writeLines(text_part2, "text_part2.jsonl")
