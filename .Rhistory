boxplot(data$`Der gemeinsame Austausch in der Tee-Ecke nach dem Spiel hat geholfen, das eigene Fremdheitserleben einzuordnen?`[data$`Der gemeinsame Austausch in der Tee-Ecke nach dem Spiel hat geholfen, das eigene Fremdheitserleben einzuordnen?`!=-99 & data$`Der gemeinsame Austausch in der Tee-Ecke nach dem Spiel hat geholfen, das eigene Fremdheitserleben einzuordnen?`!=-98])
