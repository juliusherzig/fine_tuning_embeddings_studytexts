#Die Fälle finden, bei denen das Format zerschossen ist. Zufälligerweise lassen die sich alle auf einmal dadurch identifizieren, dass der Wert in der Spalte "Logged In Username" nicht NA ist. Das entsteht bei allen Fällen durch Anführungszeichen in dem Feld zu Anmerkungen zum UNbekannten UNbehagen. Hinter den Anführungszeichen geht der Text dann fälschlicherweise nicht in derselben, sondern der nächste Spalte weiter.
# 1. Fälle identifizieren.
format_kaputt_temp <- post_clean[!is.na(post_clean$`Logged In Username`),]
# 2. Text wieder zusammenfügen, der durch Anführungszeichen in verschiedenen Spalten gelandet ist
format_kaputt_temp$`Hast du noch weitere Anmerkungen zum UNbekannten UNbehagen? (optional)`[1] <- paste(format_kaputt_temp[1, c(32:39)], collapse = "")
# 3. Zusammengefügten Text wieder zurück in Originaldatei übernehmen
post_clean$`Hast du Anmerkungen zu diesem Fragebogen? (optional)`[post_clean$id==format_kaputt_temp$id[1]] <-
format_kaputt_temp$`Hast du noch weitere Anmerkungen zum UNbekannten UNbehagen? (optional)`[1]
# 4. In Originaldatei nun alle Zeilen, wo vorher fälschlicherweise Text aus der Anmerkung zum UnUn reingefallen war, NA machen
post_clean[post_clean$id==format_kaputt_temp$id[1], c(33:39)] <- NA
# Schritte 2 bis 4 für alle in Schritt 1 identifizierten Fälle
format_kaputt_temp$`Hast du noch weitere Anmerkungen zum UNbekannten UNbehagen? (optional)`[2] <- paste(format_kaputt_temp[2, c(32:34)], collapse = "")
post_clean$`Hast du Anmerkungen zu diesem Fragebogen? (optional)`[post_clean$id==format_kaputt_temp$id[2]] <- format_kaputt_temp$`Hast du noch weitere Anmerkungen zum UNbekannten UNbehagen? (optional)`[2]
post_clean[post_clean$id==format_kaputt_temp$id[2], c(33:34)] <- NA
format_kaputt_temp$`Hast du noch weitere Anmerkungen zum UNbekannten UNbehagen? (optional)`[3] <- paste(format_kaputt_temp[3, c(32:33)], collapse = "")
post_clean$`Hast du Anmerkungen zu diesem Fragebogen? (optional)`[post_clean$id==format_kaputt_temp$id[3]] <- format_kaputt_temp$`Hast du noch weitere Anmerkungen zum UNbekannten UNbehagen? (optional)`[3]
post_clean[post_clean$id==format_kaputt_temp$id[3], c(33)] <- NA
format_kaputt_temp$`Hast du noch weitere Anmerkungen zum UNbekannten UNbehagen? (optional)`[5] <- paste(format_kaputt_temp[5, c(32:33)], collapse = "")
post_clean$`Hast du Anmerkungen zu diesem Fragebogen? (optional)`[post_clean$id==format_kaputt_temp$id[5]] <- format_kaputt_temp$`Hast du noch weitere Anmerkungen zum UNbekannten UNbehagen? (optional)`[5]
post_clean[post_clean$id==format_kaputt_temp$id[5], c(33)] <- NA
rm(format_kaputt_temp)
library(openxlsx)
library(lubridate)
library(dplyr)
#Zunächst Zeitstempel auf Datum allein reduzieren und Uhrzeit abschneiden (dd/mm/yyyy  hh:mm:ss)
post_clean$`Entry Created On` <- convertToDate(post_clean$`Entry Created On`)
#Datum der Nachbefragungsversendungen
post_clean$start[post_clean$Spielstätte=="zentrifuge"] <- "2024-03-07"
post_clean$start[post_clean$Spielstätte=="rimbeck"] <- "2024-05-17"
post_clean$start[post_clean$Spielstätte=="auerberg"] <- "2024-09-05"
post_clean$start[post_clean$Spielstätte=="karlsruhe"] <- "2024-12-21"
post_clean$start[post_clean$Spielstätte=="bornheim"] <- "2025-01-21"
post_clean$start[post_clean$Spielstätte=="zwickau"] <- "2025-07-24"
post_clean$start <- as.Date(post_clean$start)
#Nach 4 Wochen: Ende des Antwortzeitraums
post_clean$ende <- post_clean$start + days(28)
post_clean$innerhalb_antwortzeitraum <- post_clean$`Entry Created On` >= post_clean$start & post_clean$`Entry Created On` <= post_clean$ende
excl_antwortzeitraum <- post_clean[post_clean$innerhalb_antwortzeitraum==FALSE,]
post_clean <- post_clean[post_clean$innerhalb_antwortzeitraum==TRUE,]
nrow(post_clean) + nrow(excl_antwortzeitraum)
colnames(pre_raw)[colnames(pre_raw)=="PreFrage1.4.trifftzu.3.triffteherzu.2.trifftehernichtzu.1.trifftnichtzu."] <- "PreFrage1"
pre_clean <- filter(pre_raw, pre_raw$Einwilligung.1.ja.0.nein.==1)
pre_clean <- filter(pre_clean, pre_clean$Antwortenehrlich.1.ja.0.nein.==1)
pre_clean$PreMean <- rowMeans(pre_clean[,5:7], na.rm=T)
mean_pre_overall <- mean(pre_clean$PreMean, na.rm=T)
post_clean$PostMean <- NA
post_clean$PostMean <- rowMeans(post_clean[, c("PostFrage1", "PostFrage2", "PostFrage3")], na.rm=T)
mean_post_overall <- mean(post_clean$PostMean, na.rm=T)
mean_pre_overall
mean_post_overall
nrow(post_clean[post_clean$Spielstätte=="zwickau",])
#Datenaufbereitung: Matching der Vor- und Nachbefragungsantworten anhand des Pseudonyms
post_clean$Pseudonym <- toupper(post_clean$Pseudonym) #Pseudonym immer großschreiben
post_clean$Pseudonym <- trimws(post_clean$Pseudonym) #und ggf. Leerzeichen weg
data_prepost <- post_clean %>%    #Datensatz aus Vor- und Nachbefragung, wo Pseudonyme matchen
inner_join(pre_clean %>% select(Pseudonym, PreFrage1, PreFrage2, PreFrage3),
by = "Pseudonym")
mismatched_pseudonyms <- setdiff(
post_clean$Pseudonym[post_clean$Spielstätte == "zwickau"],
pre_clean$Pseudonym) #Dies sind die Nachbefragungseinträge, zu denen seltsamerweise kein äquivalentes Pseudonym in der Vorbefragung existiert. Das sind mit 20 von 50 Nachbefragungsantworten extrem und absurd viele. All diese Leute scheinen entweder bei der Vor- oder bei der Nachbefragung einen Fehler in der Erstellung des Pseudonyms gemacht zu haben, sodass wir ihre Antworten aus Vor- und Nachbefragung nicht einander zuordnen können.
length(mismatched_pseudonyms) # Number of mismatched pseudonyms
#Datenaufbereitung: Datensatz erstellen nur mit Prä- und Post-Fragen
data_prepost <- data_prepost %>%
select(Pseudonym, starts_with("Pre"), starts_with("Post")) %>%
mutate(across(starts_with("Pre"), as.numeric),
across(starts_with("Post"), as.numeric))
#Stichprobe: Wie viele Personen gehen jetzt in den Prä-Post-Vergleich ein (sprich: haben bei Nachbefragung mitgemacht und konnten über Pseudonym erfolgreich der Vorbefragung zugeordnet werden)?
nrow(data_prepost)
#Interkorrelationen innerhalb der drei Fragen
# Pre-Fragen correlations
cor_pre <- cor(data_prepost %>% select(PreFrage1, PreFrage2, PreFrage3), use = "complete.obs")
cor_pre #Man sieht: Frage 2 und 3 korrelieren stark (r=0.7). Frage 1 korreliert aber auch nicht unbeträchtlich mit Frage 2 (r=.31) und 3 (r=.34). Alle Kor. auch noch signifikant
# Post-Fragen correlations
cor_post <- cor(data_prepost %>% select(PostFrage1, PostFrage2, PostFrage3), use = "complete.obs")
cor_post #Ähnliches Muster wie in Prä-Daten
#Datenaufbereitung: Means für Prä und Post berechnen
data_prepost$PreMean  <- rowMeans(data_prepost[ ,c("PreFrage1", "PreFrage2", "PreFrage3")], na.rm = TRUE)
data_prepost$PostMean  <- rowMeans(data_prepost[ ,c("PostFrage1", "PostFrage2", "PostFrage3")], na.rm = TRUE)
#Datenaufbereitung: Prä-Post-Differenzen berechnen pro Person pro Frage und für die Means von Prä und Post
data_prepost$diff1 <- data_prepost$PostFrage1 - data_prepost$PreFrage1
data_prepost$diff2 <- data_prepost$PostFrage2 - data_prepost$PreFrage2
data_prepost$diff3 <- data_prepost$PostFrage3 - data_prepost$PreFrage3
data_prepost$diffall <- data_prepost$PostMean - data_prepost$PreMean
#Effekt Desktiptiv: Histogramme der Differenzen: Gibt es Ausreißer?
hist(data_prepost$diff1, breaks = c(-2, -1, 0, 1, 2))
hist(data_prepost$diff2, breaks = c(-2, -1, 0, 1, 2))
hist(data_prepost$diff3, breaks = c(-2, -1, 0, 1, 2))
hist(data_prepost$diffall, breaks = c(-1, -2/3, -1/3, 0, 1/3, 2/3, 1))
#Effekt inferenzstatistisch: Tests. Aufgrund des mittleren ANSTIEGS in allen Fragen ist der gerichtete t-Test eines Abfalls von Prä zu Post natürlich weder bei den jeweiligen Fragen einzeln noch in deren Mittel ansatzweise sign.
t.test(x=data_prepost$PreMean, y=data_prepost$PostMean, paired = TRUE, alternative = "g") #über alle 3 Fragen
t.test(x=data_prepost$PreFrage1, y=data_prepost$PostFrage1, paired = TRUE, alternative = "g") #Frage 1
t.test(x=data_prepost$PreFrage2, y=data_prepost$PostFrage2, paired = TRUE, alternative = "g") #Frage 2
t.test(x=data_prepost$PreFrage3, y=data_prepost$PostFrage3, paired = TRUE, alternative = "g") #Frage 3
#Wie viele gaben 3 oder 4 an in einer der Fragen
subset(data_prepost, data_prepost$PreFrage1==3|data_prepost$PreFrage1==4|
data_prepost$PreFrage2==3|data_prepost$PreFrage2==4|
data_prepost$PreFrage3==3|data_prepost$PreFrage3==4)
#Bei wie vielen sind die Werte gestiegen, bei wie vielen gefallen
diffs <- lapply(FUN=table, data_prepost[ ,c("diff1", "diff2", "diff3", "diffall")])
diffs
#Sind die Werte bei denjenigen eher gefallen, die höhere Prä-Werte hatten (Erklärung 2: Bodeneffekt)?
#Eeeeeeeeey! Wichtig! Wir sehen in allen drei Fragen, dass die Differenz von Prä zu Post umso geringer (bis negativer) wird, je höher der der Prä-Wert ist (in Frage 1 und 3 ist diese Korrelation auch signifikant). Das heißt: Die Leute mit super niedrigen Fremdenfeindlichkeitswerten in der Vorbefragung, die kaum (bei z.B. M=1.3) oder GAR NICHT in ihren Werten abfallen *konnten* (bei M=1) zeigen einen Anstieg von Prä zu Post. Dieser Anstieg ist bei denjenigen mit etwas höheren Prä-Werten immerhin  schon geringer. Und bei denjenigen mit noch höheren Prä-Werten sehen wir sogar einen Abfall (negative Differenz!). Das spricht für die Erklärung des unerwarteten Overall-Anstiegs der Werte von Prä zu Post über einen Bodeneffekt bzw. Stichprobeneffekt, also eine von Anbeginn an zu wenig fremdenfeindliche Stichprobe.
cor.test(x=data_prepost$diff1, y=data_prepost$PreFrage1, alternative="l")
cor.test(x=data_prepost$diff2, y=data_prepost$PreFrage2, alternative="l")
cor.test(x=data_prepost$diff3, y=data_prepost$PreFrage3, alternative="l")
#In diesem Sinne sehen wir in allen 3 Fragen bei denjenigen, die Prä-Wert=3 haben, desktiptiv einen Abfall zu Pos
aggregate(diff1 ~ PreFrage1, data=data_prepost, FUN=mean)
aggregate(diff2 ~ PreFrage2, data=data_prepost, FUN=mean)
aggregate(diff3 ~ PreFrage3, data=data_prepost, FUN=mean)
#Wir können leider nicht inferenzstatistisch prüfen, ob der Abfall unter denjenigen mit Pre-Wert von 3 signifikant ist, weil das zu wenige Datenpunkte sind.
