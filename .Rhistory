#Häufigkeit von Kontakt mit Menschen mit Fluchtbiographie
#Ein paar Werte hier sind -99. Das steht vermutlich für "Weiß ich nicht"
Kontakt <- data.frame(table(data$Kontakthäufigkeit))
Kontakt$Prozentual <- round(table(data$Kontakthäufigkeit)/nrow(data), digits = 3) * 100
Kontakt$Var1 <- c("Weiß ich nicht", "Nie", "Selten", "Manchmal", "Regelmäßig")
colnames(Kontakt) <- c("Kontakthäufigkeit", "Anzahl", "Prozentual")
Kontakt
print(paste("Anteil mit nicht regelmäßigem Kontakt zu Menschen mit Fluchtbiographie (nie, selten oder manchmal):",
sum(Kontakt$Prozentual[Kontakt$Kontakthäufigkeit == "Nie" | Kontakt$Kontakthäufigkeit == "Selten" | Kontakt$Kontakthäufigkeit == "Manchmal"]), "%"))
Kontakt$Kontakthäufigkeit <- factor(
Kontakt$Kontakthäufigkeit,
levels = c("Weiß ich nicht", "Nie", "Selten", "Manchmal", "Regelmäßig"))
levels(Kontakt$Kontakthäufigkeit)
library(ggplot2)
kontakt_plot <-
ggplot(Kontakt, aes(x=0, y=Prozentual, fill=Kontakthäufigkeit)) +
geom_bar(stat = "identity", width=1, color="white")+
coord_polar(theta = "y", start=3*pi/2) +
labs(title =paste0("Abbildung 3: Antworten zur Frage 'Wie oft hast du normalerweise Kontakt\n mit Menschen mit Fluchtbiografie?' (n = ", sum(Kontakt$Anzahl), ")"),
subtitle= paste0(sum(Kontakt$Prozentual[Kontakt$Kontakthäufigkeit == "Nie" | Kontakt$Kontakthäufigkeit == "Selten" | Kontakt$Kontakthäufigkeit == "Manchmal"]),
"% geben an, keinen regelmäßigen Kontakt zu Menschen mit Fluchtbiografie zu haben."),
fill = NULL)  +
ylab("")+
xlab("") +
scale_fill_manual(
values = c(
"Regelmäßig" = "#1E8449",
"Manchmal" = "#52BE80",
"Selten" = "#C3E6CB",
"Nie" = "#EAEDED",
"Weiß ich nicht" = "#696969"
)) +
theme_void() +
theme(
plot.margin = unit(c(0.2, 2.0, 0.2, 0.2), "cm"),
# Textgröße erhöhen, um den Text im Verhältnis zum Plot größer zu machen
plot.title = element_text(size = 14, hjust = 0),
plot.subtitle = element_text(size = 12, hjust = 0),
legend.text = element_text(size = 12))
kontakt_plot
