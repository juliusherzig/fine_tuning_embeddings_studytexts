# HuggingFace Hub Tokens
# Erstelle Tokens unter: https://huggingface.co/settings/tokens

# Token zum Hochladen von Modellen (write access erforderlich)
HF_TOKEN_WRITE=hf_xxxxxxxxxxxxxxxxxxxxx

# Token zum Herunterladen von Modellen (read access, kann anderer User sein)
# Optional für öffentliche Modelle
HF_TOKEN_READ=hf_xxxxxxxxxxxxxxxxxxxxx
